<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alertRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#CC0000">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 EMERGENCY ALERT 🚨"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/alertSeverity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Severity: CRITICAL"
        android:textSize="22sp"
        android:textColor="#FFEB3B"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/alertZone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zone: Z3"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/alertMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alert message"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80000000"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/alertTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time: ..."
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/ackButton"
        android:layout_width="280dp"
        android:layout_height="64dp"
        android:text="✅ ACKNOWLEDGE ALERT"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#1B5E20"
        android:textColor="#FFFFFF" />

</LinearLayout>
