# ==========================================
# RakshaSetu Git Attributes
# ==========================================

# ── Auto-normalization ──
# Force LF (Unix) line endings for all text files regardless of OS.
# Prevents mixed CRLF/LF issues between Windows/Linux.
* text=auto eol=lf

# ── Explicit Text Files ──
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf

# ── Git LFS (Large File Storage) ──
# Machine learning weights, databases, and heavy datasets
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.weights filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text
*.sqlite3 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# ── Media & Binaries ──
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
